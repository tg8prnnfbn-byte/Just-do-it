[
 {
  "text": "Last night, my dead grandmother's house called me.",
  "s": 0.05,
  "e": 2.504
 },
 {
  "text": "The line was cut six years ago.",
  "s": 2.624,
  "e": 4.259
 },
 {
  "text": "It's three oh seven a.m.",
  "s": 4.379,
  "e": 6.005
 },
 {
  "text": "My phone says: Grandma. Landline.",
  "s": 6.125,
  "e": 8.192
 },
 {
  "text": "A week ago, something called my name from the kitchen.",
  "s": 8.312,
  "e": 10.906
 },
 {
  "text": "I didn't answer.",
  "s": 11.026,
  "e": 11.902
 },
 {
  "text": "Grandma always said: if the forest calls your name, stay quiet.",
  "s": 12.202,
  "e": 15.754
 },
 {
  "text": "So I don't pick up.",
  "s": 15.874,
  "e": 16.884
 },
 {
  "text": "It leaves a voicemail.",
